# Student infrastructure layer - concrete implementations of repository interfaces.
#
# Contains InMemoryStudentRepository: a HashMap-based implementation of StudentRepository.
# In a real project, this would be replaced with a database-backed implementation
# (e.g., JPA, JDBC), but the domain and application layers would remain unchanged.

load("@rules_java//java:defs.bzl", "java_library")

java_library(
    name = "infrastructure",
    srcs = ["com/masorange/registry/infrastructure/student/InMemoryStudentRepository.java"],
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/registry/application/student:application",
        "//pkg/registry/domain/student:domain",
        "//pkg/registry/domain/student:id",
        "//jvm-deps:sqlite",
    ],
)
java_test(
    name = "StudentRepositoryIntegrationTest",
    srcs = ["com/masorange/registry/infrastructure/student/integration/StudentRepositoryIntegrationTest.java"],
    test_class = "com.masorange.registry.infrastructure.student.integration.StudentRepositoryIntegrationTest",
    size = "medium",
    deps = [
        ":infrastructure",
        "//pkg/registry/domain/student:domain",
        "//pkg/registry/domain/student:id",
        "//jvm-deps:junit",
    ],
)
